# FitBuddy - Environment Variables
# Copy this file to .env and add your real API key
# Either variable name works — GEMINI_API_KEY is preferred
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_WORKOUT_MODEL=gemini-3.5-flash-lite
GEMINI_NUTRITION_MODEL=gemini-3.5-flash-lite
GEMINI_UPDATE_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
